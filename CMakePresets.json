{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TELINHA_BUILD_TESTS": "ON",
        "TELINHA_BUILD_BENCHMARKS": "ON",
        "TELINHA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "linux-debug",
      "inherits": "ninja",
      "displayName": "Linux debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-release",
      "inherits": "ninja",
      "displayName": "Linux release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-clang-release",
      "inherits": "linux-release",
      "displayName": "Linux release, clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "ninja",
      "displayName": "Linux address and undefined sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TELINHA_SANITIZER": "address",
        "TELINHA_ENABLE_LTO": "OFF"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-tsan",
      "inherits": "ninja",
      "displayName": "Linux thread sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TELINHA_SANITIZER": "thread",
        "TELINHA_ENABLE_LTO": "OFF"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-debug",
      "inherits": "base",
      "displayName": "MSVC x64 debug",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-debug",
      "displayName": "MSVC x64 release"
    },
    {
      "name": "msvc-ninja-release",
      "inherits": "ninja",
      "displayName": "MSVC x64 release, Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "msvc-ninja-release", "configurePreset": "msvc-ninja-release" }
  ],
  "testPresets": [
    {
      "name": "common",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "linux-debug", "inherits": "common", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "common", "configurePreset": "linux-release" },
    { "name": "linux-clang-release", "inherits": "common", "configurePreset": "linux-clang-release" },
    { "name": "linux-asan", "inherits": "common", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "inherits": "common", "configurePreset": "linux-tsan" },
    { "name": "msvc-debug", "inherits": "common", "configurePreset": "msvc-debug", "configuration": "Debug" },
    { "name": "msvc-release", "inherits": "common", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "msvc-ninja-release", "inherits": "common", "configurePreset": "msvc-ninja-release" }
  ]
}
